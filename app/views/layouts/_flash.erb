<% unless controller_name == 'movies' && action_name == 'search_tmdb' %>
  <% if flash[:notice] %>
    <div class="alert alert-info" role="alert" id="notice">
      <%= flash[:notice] %>
    </div>
  <% elsif flash[:warning] %>
    <div class="alert alert-danger" role="alert" id="warning">
      <%= flash[:warning] %>
    </div>
  <% end %>
<% end %>
